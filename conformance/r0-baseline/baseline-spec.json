    "pausing",
    "paused",
    "completed",
    "failed",
    "cancel_requested",
    "cancelled"
  ],
  "objectEditFsm": {
    "states": [
      "analyzing",
      "awaiting_target_selection",
      "awaiting_mask_review",
      "awaiting_generation_review",
      "completed",
      "failed"
    ],
    "transitions": [
      {
        "action": "open_object_edit",
        "from": null,
        "to": "analyzing",
        "actorRole": "operator",
        "preconditions": ["expectedRevision == project.revision", "non-empty non-negative sourceRange"]
      },
      {
        "action": "record_object_candidates",
        "from": "analyzing",
        "to": "awaiting_target_selection",
        "actorRole": "owner",
        "preconditions": ["expectedWorkflowRevision match", "1..32 unique objectId and trackId candidates"]
      },
      {
        "action": "decide_object_target",
        "from": "awaiting_target_selection",
        "to": "awaiting_mask_review | completed",
        "actorRole": "operator",
        "preconditions": [
          "expectedWorkflowRevision match",
          "project.revision == workflow.baseTimelineRevision",
          "asset.original.sha256 == workflow.assetContentHash",
          "if removalTargets > 0 -> awaiting_mask_review else completed"
        ]
      },
      {
        "action": "review_object_mask",
        "from": "awaiting_mask_review",
        "to": "awaiting_generation_review | awaiting_mask_review",
        "actorRole": "operator",
        "preconditions": ["expectedWorkflowRevision match", "approved=true -> awaiting_generation_review; approved=false -> awaiting_mask_review"]
      },
      {
        "action": "record_object_qa",
        "from": "awaiting_generation_review",
        "to": "completed | failed",
        "actorRole": "owner",
        "preconditions": ["expectedWorkflowRevision match", "QA verdict passed -> completed else failed"]
      }
    ],
    "generationGuard": {
      "requiredState": "awaiting_generation_review",
      "requiresRemovalTargets": true
    },
    "invalidationRule": "If project timeline revision or source asset contentHash changes after workflow open, target decisions fail with REVISION_CONFLICT."
  },
  "failureRecoveryMatrix": [
    {
      "id": "FR-01",
      "scenario": "Same requestId + same payload replay",
      "expected": "Idempotent return of original mutation result without duplicate side effects"
    },
    {
      "id": "FR-02",
      "scenario": "Same requestId + different payload",
      "expected": "Reject with IDEMPOTENCY_CONFLICT"
    },
    {
      "id": "FR-03",
      "scenario": "Stale expectedRevision on mutation",
      "expected": "Reject with REVISION_CONFLICT"
    },
    {
      "id": "FR-04",
      "scenario": "Lost mutation response on disconnect",
      "expected": "Client reconciles via video.v1.get_mutation_result(projectId, requestId)"
    },
    {
      "id": "FR-05",
      "scenario": "Upload commit with mismatched bytes or SHA-256",
      "expected": "Reject with ARTIFACT_HASH_MISMATCH and do not register SourceAsset"
    },
    {
      "id": "FR-06",
      "scenario": "Expired, rejected, revoked, or consumed approval used in create_job",
      "expected": "Reject with APPROVAL_EXPIRED / APPROVAL_CONSUMED / PERMISSION_DENIED"
    },
    {
      "id": "FR-07",
      "scenario": "Project revision advances or source asset changes after plan/object edit",
      "expected": "Prior approvals and target decisions become invalid (REVISION_CONFLICT)"
    },
    {
      "id": "FR-08",
      "scenario": "Client reconnect after gap",
      "expected": "Resume via get_events(afterSeq); set snapshotRequired=true when gap cannot be served incrementally"
    },
    {
      "id": "FR-09",
      "scenario": "Daemon restart with active job states (analyzing/rendering_preview/rendering_final/validating/pausing/cancel_requested)",
      "expected": "Recover job to failed with error.code=NEEDS_RECONCILIATION and emit job.state.changed event"
    },
    {
      "id": "FR-10",
      "scenario": "Daemon restart with active planning run (running/awaiting_input)",
      "expected": "Emit run.interrupted; never blindly replay planning runs"
    },
    {
      "id": "FR-11",
      "scenario": "Agent planning session settles",
      "expected": "agent_settled ends planning run only; never approves plans or marks EditJobs completed"
    },
    {
      "id": "FR-12",
      "scenario": "Source asset mutability",
      "expected": "sourceNeverWritable is literal true; all renders go to staging and commit atomically to CAS"
    },
    {
      "id": "FR-13",
      "scenario": "Legacy/Native coexistence isolation",
      "expected": "Native daemon uses isolated AVE_HOME; never shares SQLite DB or CAS directory with legacy paseoHome/video-editor"
    }
  ],
